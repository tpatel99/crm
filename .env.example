SECRET_KEY=generate-a-long-random-string
BASE_URL=http://localhost:8000
# Okta: create an OIDC Web App; redirect URI = BASE_URL/api/auth/callback
OKTA_ISSUER=https://your-org.okta.com/oauth2/default
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# Local dev only, never in production:
DEV_AUTH=false
# No login (everyone is admin). Only run this on a private network until Okta is set up.
AUTH_DISABLED=true  # set false (and fill Okta values) for any shared deployment
